# Harness generates the real .codex/config.toml locally with mode 0600.
# Run the isolated or global Codex installation flow documented in
# docs/development/isolated-development.md. Do not copy this placeholder as-is.

developer_instructions = "Harness is required for repository work. `project_status` must be the first repository action."

[mcp_servers.harness]
url = "http://127.0.0.1:17375/mcp"
required = true
startup_timeout_sec = 30

[mcp_servers.harness.http_headers]
Authorization = "Bearer <private capability generated by Harness>"
"X-Harness-Workspace-Root" = "/absolute/path/to/workspace"
