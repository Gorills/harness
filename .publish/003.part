+def request_workspace_task_status(
+    socket_path: Path,
+    hints: Sequence[WorkspaceHint],
+    *,
+    timeout: float = _DEFAULT_TIMEOUT_SECONDS,
+) -> WorkspaceTaskStatusResult:
+    """Request bounded current/relevant Task status for one resolved Workspace."""
