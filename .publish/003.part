+            "request_id": request_id,
+            "method": "workspace_task_status",
+            "params": {"hints": _workspace_hints_to_wire(hints)},
+        },
+        timeout=timeout,
+    )
+    return _workspace_task_status_from_response(response, expected_request_id=request_id)
