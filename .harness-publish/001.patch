+    hits: list[ProjectSearchHit] = []
+    for result in results:
+        is_doc = is_document_path(result.relative_path)
+        kind = ProjectSearchKind.DOC if is_doc else ProjectSearchKind.CODE
+        prefix = "doc" if is_doc else "code"
